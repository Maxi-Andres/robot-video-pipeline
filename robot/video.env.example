# Robot-side video config. Copy to video.env and edit; the systemd unit reads it, so
# changing a value needs no root and no touching /etc/systemd.
#
#   cp robot/video.env.example robot/video.env
#   nano robot/video.env
#   sudo systemctl restart robot-video
#
# video.env is gitignored on purpose: it is per-deployment, and a `git pull` must never
# overwrite the IP of the machine this robot reports to.
#
# TWO INDEPENDENT PATHS come out of the robot, and they are tuned separately:
#
#   live view  : raw JPEGs over HTTP (:MJPEG_PORT/stream). Short path — no encode, no
#                mediamtx, no NVR — so this is the one to keep LOW LATENCY.
#   recording  : H.264 over RTMP to mediamtx -> Frigate. Latency does not matter here;
#                bandwidth and quality do.

# ============================ LIVE VIEW (low latency) ============================
# Serve the raw JPEGs over HTTP. This is what AI-VL and the Splunk dashboard should read.
MJPEG_ENABLE=1
MJPEG_PORT=8093
MJPEG_BIND=0.0.0.0
# Cap for HTTP viewers ONLY (0 = every frame). Frames over the cap are DROPPED, never
# queued, so lowering this cuts bandwidth without ever adding delay.
MJPEG_FPS=0

# Send the camera's own frames untouched by default: no CPU on the Jetson, no quality lost.
# 0 = native 1920 wide.
#
# WHEN TO SET IT: MJPEG has no inter-frame compression, so native 1080p is ~221 KB a frame.
# At the camera's real 14 fps that is 3.0 MB/s — fine on a LAN, impossible on a constrained
# link. Measured on the IR1101 path: 353 kB/s, i.e. 1.6 fps of native frames. Setting a
# width decodes/resizes/re-encodes for HTTP viewers ONLY; the NVR branch always keeps the
# original 1080p bytes.
#   0    -> native 1920, nothing re-encoded          (LAN)
#   1280 -> ~90 KB a frame
#   640  -> ~36 KB a frame                            (measured; use this off-LAN)
# NOTE the resize is done by cv2 on the Jetson's CPU and costs ~400 ms a frame, which caps
# the live view around 2.4 fps. Below that ceiling it is the bandwidth that decides.
MJPEG_WIDTH=0
MJPEG_QUALITY=75

# ============================ CAPTURE (affects both) ============================
# Frames per second pulled from the camera. This bounds everything downstream, so it is the
# first knob to turn: fewer frames = less work, less bandwidth, lower latency.
MAXFPS=15

# ============================ RECORDING (H.264 -> NVR) ============================
# Where mediamtx runs. THE ONE THAT CHANGES most often.
PUBLISH_HOST=192.168.20.99
PROTO=rtmp
STREAM=robot

# Frames per second handed to the H.264 encoder, on a REGULAR interval. The live view keeps
# the full capture rate regardless — this only sets what gets recorded.
#   Why a fixed rate and not "everything": the encoder needs a cadence. Feeding it whatever
#   the uplink leaves over produced irregular timestamps and a stream Frigate refused
#   ("no frames have been received"). 5 fps of 1080p is plenty for a recording.
NVR_FPS=5

# Feed the recording branch at all. 0 = live view only. Diagnostic switch: both branches
# share one uplink, so this is the one-step way to prove whether a live-view stall is the
# recorder competing for bandwidth.
NVR_ENABLE=1

# Encoder bitrate in bits/s. Lower = less bandwidth and a shorter encode queue.
# BEWARE: this shares the link with the live view and with everything else. 2 Mbps is
# 250 kB/s — measured, that is ~70% of the IR1101 path on its own. Off-LAN, drop it.
BITRATE=2000000

# Scale on the GPU before encoding. Empty = native 1920x1080. Smaller frames encode faster
# and need less bitrate for the same quality, so this is a latency knob too.
#   WIDTH=1280
#   HEIGHT=720
WIDTH=
HEIGHT=

# Keyframe interval, in frames. 15 at 15 fps = one per second. LOWER makes a new viewer
# start seeing picture sooner (a decoder cannot start mid-GOP) at the cost of bitrate.
IDR_FRAMES=15

# SRT only (PROTO=srt): loss-recovery budget in ms. Raise it on a satellite link.
LATENCY=300

# ============================ MISC ============================
# The robot's internal bus. Do not change unless the robot's interfaces are renamed.
NIC=eth0
