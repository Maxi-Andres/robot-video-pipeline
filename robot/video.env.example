# Robot-side video config. Copy to video.env and edit; the systemd unit reads it, so
# changing a value needs no root and no touching /etc/systemd.
#
#   cp robot/video.env.example robot/video.env
#   nano robot/video.env
#   sudo systemctl restart robot-video
#
# video.env is gitignored on purpose: it is per-deployment, and a `git pull` must never
# overwrite the IP of the machine this robot reports to.
#
# TWO INDEPENDENT PATHS come out of the robot, and they are tuned separately:
#
#   live view  : raw JPEGs over HTTP (:MJPEG_PORT/stream). Short path — no encode, no
#                mediamtx, no NVR — so this is the one to keep LOW LATENCY.
#   recording  : H.264 over RTMP to mediamtx -> Frigate. Latency does not matter here;
#                bandwidth and quality do.

# ============================ LIVE VIEW (low latency) ============================
# Serve the raw JPEGs over HTTP. This is what AI-VL and the Splunk dashboard should read.
MJPEG_ENABLE=1
MJPEG_PORT=8093
MJPEG_BIND=0.0.0.0
# Cap for HTTP viewers ONLY (0 = every frame). Frames over the cap are DROPPED, never
# queued, so lowering this cuts bandwidth without ever adding delay.
#
# 0 IS THE WRONG DEFAULT OVER A FIELD LINK, and it is not obvious why: this stream is pulled
# straight off the robot by robot_camera_bridge, IN PARALLEL with the RTMP push — the same
# picture leaving twice. Measured over LTE on 2026-09-09 it was 218 KB/s against the RTMP's
# 42, and it starved the RTMP: the NVR queue sat full at 8 with 15228 frames dropped and
# Frigate showed 0 fps. Capping to 5 fps at quality 55 halved it to 105 KB/s, the queue
# drained to 0, drops stopped, and Frigate came back at a steady 5.1 fps.
#
# Leave 0 only while the robot is on the LAN. In the field, cap it.
MJPEG_FPS=0

# Send the camera's own frames untouched by default: no CPU on the Jetson, no quality lost.
# 0 = native 1920 wide.
#
# WHEN TO SET IT: MJPEG has no inter-frame compression, so native 1080p is ~221 KB a frame.
# At the camera's real 14 fps that is 3.0 MB/s — fine on a LAN, impossible on a constrained
# link. Measured on the IR1101 path: 353 kB/s, i.e. 1.6 fps of native frames. Setting a
# width decodes/resizes/re-encodes for HTTP viewers ONLY; the NVR branch always keeps the
# original 1080p bytes.
#   0    -> native 1920, nothing re-encoded          (LAN)
#   1280 -> ~90 KB a frame
#   640  -> ~36 KB a frame                            (measured; use this off-LAN)
# NOTE the resize is done by cv2 on the Jetson's CPU and costs ~400 ms a frame, which caps
# MEASURED PROPERLY 2026-09-16: the resize costs 28 ms of CPU, not 400. The old number here
# (and the 105 ms we measured in production) was mostly the cgroup being FROZEN by
# `CPUQuota=50%` in robot-video.service, not computation — see PLAN-VIDEO.md §6.c. With the
# quota replaced by CPUWeight it is 29.4 ms, max 34.5. So the live view is NOT capped around
# 2.4 fps; it runs at the source rate and the bandwidth is what decides.
#
# At 640 wide and quality 55 a frame is ~20 KB, so 13 fps is ~2 Mbps on its own. Over a field
# link the knob that decides is MJPEG_FPS, not the width: 5 fps is ~0.8 Mbps and leaves room
# for the H.264 branch inside a 2 Mbps budget.
MJPEG_WIDTH=0
MJPEG_QUALITY=75

# ============================ WHERE THE PICTURE COMES FROM ============================
# jpeg       the videohub, one JPEG per RPC, then decoded and re-encoded to H.264 here.
#            What has always run. The ONLY source where BITRATE/NVR_FPS/MAXFPS/IDR_FRAMES
#            do anything, which is why it is the one to fall back to on a bad field link.
# multicast  the H.264 the Go2 ALREADY encodes, read as RTP off a multicast group. Nothing
#            is decoded and nothing is re-encoded, and the videohub is never asked.
#            The multicast does NOT cross the network: it is joined on the robot's own
#            internal bus ($NIC), and what leaves the robot is the same unicast RTMP as
#            always. NAT and LTE are not a problem. The bitrate is, see below.
#
# MEASURED 2026-09-14: multicast gives 1280x720 at 13.9 fps for 2.02 Mbps, against 1080p at
# ~4.7 fps for 1.42 Mbps — 3x the frames for 1.4x the bandwidth, and HALF the bits per frame.
# It also leaves the Jetson with no encoding to do at all.
#
# THE LATENCY QUESTION IS SETTLED, AND THE ANSWER WAS NO. Measured the same day by two
# independent methods: multicast and jpeg have the SAME glass-to-glass. The "~650 ms of the
# videohub, about 90% of the latency" that used to be written here was never a real number —
# it came from comparing against a clock that was not ours, and the same method produced
# -710 ms and -1400 ms, both impossible. Skipping the videohub changed nothing, so the latency
# lives upstream of both paths and is still UNMEASURED. Pick multicast for frames, bandwidth
# per frame and Jetson load. Not for latency.
#
# THE KNOB YOU LOSE. On multicast the encoder is Unitree's, inside the robot, and BITRATE,
# NVR_FPS, MAXFPS and IDR_FRAMES are all inert — run-video.sh zeroes them for this source.
# It also sends MORE: 1.78 Mbps against 1.43, 14.25 fps against 4.5. On a lossy link that is
# the wrong direction, because the freezing here is loss with TCP retransmission and sending
# less loses less. If a field link starts freezing, go back to SOURCE=jpeg.
#
# NOTE: multicast has no JPEG, so it turns the MJPEG live view off on its own.
SOURCE=jpeg
MCAST_ADDR=230.1.1.1
MCAST_PORT=1720

# ============================ CAPTURE (affects both) ============================
# Frames per second pulled from the camera. This bounds everything downstream, so it is the
# first knob to turn: fewer frames = less work, less bandwidth, lower latency.
MAXFPS=15

# ============================ RECORDING (H.264 -> NVR) ============================
# Where mediamtx runs. THE ONE THAT CHANGES most often.
PUBLISH_HOST=192.168.20.99
PROTO=rtmp
STREAM=robot

# Frames per second handed to the H.264 encoder, on a REGULAR interval. The live view keeps
# the full capture rate regardless — this only sets what gets recorded.
#   Why a fixed rate and not "everything": the encoder needs a cadence. Feeding it whatever
#   the uplink leaves over produced irregular timestamps and a stream Frigate refused
#   ("no frames have been received"). 5 fps of 1080p is plenty for a recording.
NVR_FPS=5

# Feed the recording branch at all. 0 = live view only. Diagnostic switch: both branches
# share one uplink, so this is the one-step way to prove whether a live-view stall is the
# recorder competing for bandwidth.
NVR_ENABLE=1

# Encoder bitrate in bits/s. Lower = less bandwidth and a shorter encode queue.
# BEWARE: this shares the link with the live view and with everything else. 2 Mbps is
# 250 kB/s — measured, that is ~70% of the IR1101 path on its own. Off-LAN, drop it.
BITRATE=2000000

# Scale on the GPU before encoding. Empty = native 1920x1080. Smaller frames encode faster
# and need less bitrate for the same quality, so this is a latency knob too.
#   WIDTH=1280
#   HEIGHT=720
WIDTH=
HEIGHT=

# Keyframe interval, in frames. 15 at 15 fps = one per second. LOWER makes a new viewer
# start seeing picture sooner (a decoder cannot start mid-GOP) at the cost of bitrate.
IDR_FRAMES=15

# SRT only (PROTO=srt): loss-recovery budget in ms. Raise it on a satellite link.
LATENCY=300

# ============================ MISC ============================
# The robot's internal bus. Do not change unless the robot's interfaces are renamed.
NIC=eth0

# Latency instrumentation. Splices two robot-side timestamps into a JPEG COM segment so the
# drive-view latency can be split per stage from off the robot — COM is ignored by every
# decoder and every hop downstream forwards the bytes untouched, so it is readable all the
# way to the browser without changing what it measures.
#
# Measured cost: 1.4 us per frame. It is safe to leave on during a real drive; it is off by
# default only because an unread stamp is 32 bytes of nothing.
#
# Read it with tests/_latency_probe.py. /health reports whether it is on.
STAMP=0
