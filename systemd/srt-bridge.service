# SRT receiver for the robot's H.264 stream, on the HQ side.
#
# WHY A BRIDGE AT ALL, and not just mediamtx's own SRT listener: the robot ships
# libsrt 1.4.0 (Ubuntu 20.04) and mediamtx's Go SRT implementation REJECTS its handshake —
# the robot logs "REJECT reported from HS processing" and mediamtx logs nothing at all,
# which is the diagnostic trap. The same pipeline connects fine to an ffmpeg/libsrt
# listener, so the incompatibility is libsrt-1.4.0 <-> mediamtx, not the robot or the link.
# srt-live-transmit is that same libsrt (1.5.4 here), so it accepts the robot and hands the
# stream to mediamtx over loopback UDP, where nothing can be lost.
#
#     robot --SRT/UDP--> srt-live-transmit --udp+mpegts--> mediamtx --WebRTC--> browser
#                                                                 \--RTSP----> Frigate
#
# THE RECEIVER NEEDS A BIG UDP BUFFER. mediamtx defaults udpReadBufferSize to 0 (212 KB),
# and that silently loses 15% of the frames on this loopback hop: a keyframe arrives as a
# burst, a burst overflows a small socket buffer, and one lost fragment costs everything up
# to the next keyframe. MEASURED: 20 freezes totalling 64 s in 6 minutes, with SRT itself
# reporting zero drops. Set udpReadBufferSize (4194304 here, capped by net.core.rmem_max)
# in the mediamtx config that reads :9000 — production included, the day it moves there.
#
# PORT 8891, NOT 8890. The plan says 8890, but production mediamtx already binds that for
# its own (unusable from this robot) SRT listener, so the bridge would fail to start. Either
# use 8891 as here, or set `srt: no` in mediamtx.yml and free 8890 — the config already
# documents that listener as unusable, so freeing it is the tidier end state.
#
# Install:
#   sudo apt install srt-tools
#   mkdir -p ~/.config/systemd/user && cp systemd/srt-bridge.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now srt-bridge
[Unit]
Description=SRT -> UDP/MPEG-TS bridge for the robot video stream
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# The stats are the whole point of running this in the foreground of a unit: SRT HIDES the
# loss it repairs, so without them a link the ARQ is quietly saving looks identical to a
# healthy one. pktRcvLoss and pktRcvRetrans are the numbers that say how hard it is working,
# and they are the ones that will decide plan A against plan B over LTE.
#
# The flag is -stats-report-frequency, with dashes. Spelled -statsreport-frequency it is
# accepted and silently ignored, which is how it was first written here and why the first
# run produced no statistics at all.
ExecStart=/usr/bin/srt-live-transmit \
  -stats-report-frequency:2000 -statspf:json -fullstats -loglevel:note \
  "srt://:8891?mode=listener&latency=150" \
  "udp://127.0.0.1:9000"
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
