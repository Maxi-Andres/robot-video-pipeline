# --- Downloaded binaries (recreate with ./setup.sh) ---
/bin/
/mediamtx
/mediamtx.stock.yml

# --- Compiled programs (recreate with ./build.sh) ---
/go2_jpeg_stream
/go2_h264_stream
*.o

# --- mediamtx auto-generated TLS certs ---
/auto.crt
/auto.key

# --- Frigate runtime data: keep only the config we wrote ---
/frigate/media/
/frigate/config/*
!/frigate/config/config.yml

# --- Python bytecode and test caches (the repo had no suite until 2026-08-28) ---
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*

# --- misc ---
*.log
robot/video.env

# generated by tests/video-bench: one line per measurement window
tests/video-bench/report.jsonl
